{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xenora-lagoon",
  "main": "./worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
